# Admin workstation tools for the platform lab.
# Install with: brew bundle --file platform/workstation/Brewfile
# More tools (argocd, kubeseal, kargo...) get added here in later phases.

brew "kubernetes-cli"   # kubectl
brew "helm"             # Kubernetes package manager
brew "k9s"              # terminal UI for the cluster
brew "kubectx"          # kubectx / kubens: switch context and namespace
brew "stern"            # tail logs from many pods at once
brew "jq"               # JSON processing
brew "yq"               # YAML processing
brew "gh"               # GitHub CLI (repos, PRs, Actions runs)
brew "bind"             # dig + nsupdate (testing the apps.lab.local dynamic zone)
